SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu_clave_publica

# Solo para scripts administrativos como limpiar_base.py o simulador.py.
# Nunca subas una llave real de service_role al repositorio.
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_local

# Por defecto queda apagado para que no aparezca el aviso de version al iniciar sesion.
VERIFICAR_ACTUALIZACIONES=0

# Activa logs detallados de login en consola sin mostrar contraseñas.
DEBUG_LOGIN=0
